{
  "dart.flutterSdkPath": "/Users/shiki/.local/opt/flutter",

  "dart.lineLength": 100,
  "dart.previewFlutterUiGuides": true,

  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80]
  },

  "[rust]": {
    "editor.formatOnSave": true
  },

  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.cargo.allTargets": true,
  
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/target": true
  },

  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/target": true
  }
}